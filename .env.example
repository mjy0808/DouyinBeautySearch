# Only needed by the collector; never exposed to the website.
VISION_API_KEY=
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=gpt-4.1-mini
# responses or chat (for other OpenAI-compatible services)
VISION_API_MODE=responses
# Optional local Chrome executable. In CI, use Playwright's installed Chromium.
BROWSER_EXECUTABLE=
